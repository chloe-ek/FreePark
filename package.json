{
  "name": "freepark",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.1",
    "babel-preset-expo": "~54.0.10",
    "dotenv": "^17.4.2",
    "env": "^0.0.2",
    "expo": "~54.0.0",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "utils",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/utils/__tests__/*.test.ts"
        ],
        "transform": {
          "^.+\\.tsx?$": [
            "ts-jest",
            {
              "tsconfig": {
                "jsx": "react"
              }
            }
          ]
        }
      },
      {
        "displayName": "rn",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/src/**/__tests__/*.test.tsx"
        ]
      }
    ]
  },
  "private": true
}
